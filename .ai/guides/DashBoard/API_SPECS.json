{
  "info": {
    "title": "CheeseAndCream - Dashboard API",
    "description": "Financial metrics and accounts receivable API",
    "version": "1.0.0",
    "contact": {
      "name": "Backend Team"
    }
  },
  "baseUrl": "http://localhost:8080/api",
  "endpoints": [
    {
      "id": 1,
      "name": "Get Monthly Financial Metrics",
      "method": "GET",
      "path": "/dashboard/monthly/{month}",
      "fullUrl": "http://localhost:8080/api/dashboard/monthly/{month}",
      "description": "Returns complete financial dashboard data for a specific month including debt, revenue, profit, and pending balance",
      "parameters": {
        "path": [
          {
            "name": "month",
            "type": "integer",
            "required": true,
            "description": "Month number (1-12)",
            "example": 9
          }
        ]
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "totalDebt": {
              "type": "number",
              "format": "double",
              "description": "Sum of all PURCHASE operations"
            },
            "totalRevenue": {
              "type": "number",
              "format": "double",
              "description": "Sum of all SALE operations"
            },
            "totalProfit": {
              "type": "number",
              "format": "double",
              "description": "Sum of SALE + PAYMENT operations"
            },
            "pendingBalance": {
              "type": "number",
              "format": "double",
              "description": "Outstanding balance = SUM(SALE) - SUM(PAYMENT)"
            }
          }
        },
        "example": {
          "totalDebt": 8500.50,
          "totalRevenue": 22000.00,
          "totalProfit": 15000.00,
          "pendingBalance": 4200.75
        }
      },
      "statusCodes": [
        {
          "code": 200,
          "description": "Success"
        },
        {
          "code": 400,
          "description": "Invalid month (must be 1-12)"
        }
      ]
    },
    {
      "id": 2,
      "name": "Get Total Pending Balance",
      "method": "GET",
      "path": "/dashboard/pending-balance/total",
      "fullUrl": "http://localhost:8080/api/dashboard/pending-balance/total",
      "description": "Returns total accounts receivable across all operations (all time)",
      "parameters": {
        "path": [],
        "query": []
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "schema": {
          "type": "number",
          "format": "double",
          "description": "Total amount all customers owe"
        },
        "example": 12500.50
      },
      "statusCodes": [
        {
          "code": 200,
          "description": "Success"
        }
      ]
    },
    {
      "id": 3,
      "name": "Get Pending Balance by Agent/Customer",
      "method": "GET",
      "path": "/dashboard/pending-balance/agent/{agentId}",
      "fullUrl": "http://localhost:8080/api/dashboard/pending-balance/agent/{agentId}",
      "description": "Returns how much a specific customer still owes",
      "parameters": {
        "path": [
          {
            "name": "agentId",
            "type": "integer",
            "format": "int64",
            "required": true,
            "description": "Unique ID of the agent/customer",
            "example": 5
          }
        ]
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "schema": {
          "type": "number",
          "format": "double",
          "description": "Outstanding balance for the specific customer"
        },
        "example": 2500.00
      },
      "statusCodes": [
        {
          "code": 200,
          "description": "Success"
        },
        {
          "code": 404,
          "description": "Agent not found"
        }
      ]
    },
    {
      "id": 4,
      "name": "Get Pending Balance by Month",
      "method": "GET",
      "path": "/dashboard/pending-balance/monthly/{month}",
      "fullUrl": "http://localhost:8080/api/dashboard/pending-balance/monthly/{month}",
      "description": "Returns the pending balance (unpaid sales) for a specific month",
      "parameters": {
        "path": [
          {
            "name": "month",
            "type": "integer",
            "required": true,
            "description": "Month number (1-12)",
            "example": 9
          }
        ]
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "schema": {
          "type": "number",
          "format": "double",
          "description": "Outstanding balance from sales made in the specified month"
        },
        "example": 1800.50
      },
      "statusCodes": [
        {
          "code": 200,
          "description": "Success"
        },
        {
          "code": 400,
          "description": "Invalid month (must be 1-12)"
        }
      ]
    }
  ],
  "financialMetrics": {
    "debt": {
      "name": "Total Debt",
      "calculation": "Sum of all PURCHASE operations",
      "meaning": "Total amount we owe to suppliers",
      "accessibleVia": ["GET /dashboard/monthly/{month}"]
    },
    "revenue": {
      "name": "Total Revenue",
      "calculation": "Sum of all SALE operations",
      "meaning": "Total sales made (gross income)",
      "accessibleVia": ["GET /dashboard/monthly/{month}"]
    },
    "profit": {
      "name": "Total Profit",
      "calculation": "Sum of SALE + PAYMENT operations",
      "meaning": "Net profit after collections",
      "accessibleVia": ["GET /dashboard/monthly/{month}"]
    },
    "pendingBalance": {
      "name": "Pending Balance (Accounts Receivable)",
      "calculation": "SUM(SALE) - SUM(PAYMENT)",
      "meaning": "Total amount customers still owe for products sold",
      "accessibleVia": [
        "GET /dashboard/monthly/{month}",
        "GET /dashboard/pending-balance/total",
        "GET /dashboard/pending-balance/agent/{agentId}",
        "GET /dashboard/pending-balance/monthly/{month}"
      ]
    }
  },
  "operationTypes": {
    "SALE": "Product sale (increases revenue, increases pending balance until paid)",
    "PURCHASE": "Supplier purchase (increases debt)",
    "PAYMENT": "Payment received from customer (decreases pending balance)"
  },
  "notes": {
    "softDeletes": "Only active records (active = true) are included in calculations",
    "nullHandling": "If no data exists for a period, the endpoint returns 0.0",
    "dateRange": "Monthly queries calculate from the 1st to the last day of the specified month",
    "performance": "All queries use indexed database operations, typically <50ms execution time",
    "authentication": "Currently no authentication required (future enhancement: add role-based access)"
  }
}

